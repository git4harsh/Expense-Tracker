# Copy to .env (do not commit .env) and adjust values for your environment.
# Docker Compose automatically reads .env from this directory.

# --- Application ---
PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-bytes-long
# Short-lived access token; refresh token is used to rotate/renew.
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# Database (container-to-container defaults for Compose; override for host/local runs)
DB_URL=jdbc:mysql://mysql:3306/expense_tracker?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# Kafka bootstrap servers (Compose internal listener). For host-local app use localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# CORS: comma-separated allowed origins (empty = safe local defaults in code)
APP_CORS_ALLOWED_ORIGINS=

# --- Infrastructure containers ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=expense_tracker
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
